/*
 * -------------------------------------------------
 *  Nextflow config file for running tests
 * -------------------------------------------------
 * Defines bundled input files and everything required
 * to run a fast and simple test. Use as follows:
 *   nextflow run nf-core/methylseq -profile test
 */

params {
  // Genome Reference File Pathds
  genome = "/fh/scratch/delete30/blancomelo_d/RNAseq_pipeline/ref/hg19.genome.fa"
  star_indices = "/fh/scratch/delete30/blancomelo_d/RNAseq_pipeline/ref/hg19_herv_star_index/"
  genome_refseq = "/fh/scratch/delete30/blancomelo_d/RNAseq_pipeline/ref/hg19.refseq_curated.bed"
  annotation_gtf = "/fh/scratch/delete30/blancomelo_d/RNAseq_pipeline/ref/hg19_refseq_herv.gtf"
  chrom_sizes = "/fh/scratch/delete30/blancomelo_d/RNAseq_pipeline/ref/hg19.chrom.sizes"
  salmon_indices = "/fh/scratch/delete30/blancomelo_d/RNAseq_pipeline/ref/hg19_salmon_index_herv_pc"
}
